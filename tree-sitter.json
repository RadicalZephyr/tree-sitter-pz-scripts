{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "pz_scripts",
      "camelcase": "PzScripts",
      "scope": "source.pz",
      "path": ".",
      "file-types": null,
      "injection-regex": "^pz(_scripts)?$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "ISC",
    "description": "Project Zomboid scripts grammar for tree-sitter",
    "authors": [
      {
        "name": "Zefira Shannon"
      }
    ],
    "links": {
      "repository": "https://github.com/RadicalZephyr/tree-sitter-pz-scripts"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}